# Payroll360 Environment Configuration

# Server Port
PORT=3001

# JWT signing secret (replace with a strong, random secret)
JWT_SECRET=replace-with-a-strong-random-secret

# MongoDB Connection URI (MERN Stack Backend)
# If local mongod is not running, server automatically runs in persistent local mode
MONGODB_URI=mongodb://localhost:27017/payroll360

# Frontend Client URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development
